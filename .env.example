# Optional client override for testing the message relay locally
VASANTH_ENDPOINT=http://127.0.0.1:8000/api/message

# Delay multiplier (e.g. 0.5 is twice as fast, 2 is slower)
# VASANTH_SPEED=1.0

# Set to 1 to remove all animation delays (instant)
# VASANTH_FAST=1

# Standard opt-out for colour
# NO_COLOR=1
